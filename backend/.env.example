# ---------------------------------------------------------------------------
# Adaptive Multimodal Agentic RAG Assistant — backend environment
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- LLM provider (set EXACTLY ONE of the two keys) ---------------------------
# The app auto-detects the provider:
#   * If OPENAI_API_KEY is set  -> OpenAI  + text-embedding-3-small (dim=1536)
#   * elif GOOGLE_API_KEY is set-> Gemini  + text-embedding-004     (dim=768)
# If BOTH are set, PROVIDER (below) breaks the tie; default preference = openai.
OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Optional explicit override when both keys are present: "openai" | "gemini"
# PROVIDER=openai

# Optional model overrides (sensible defaults are used if unset)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o-mini
# GEMINI_CHAT_MODEL=gemini-1.5-flash
# GEMINI_VISION_MODEL=gemini-1.5-flash

# --- Web search fallback -----------------------------------------------------
TAVILY_API_KEY=

# --- Vector DB (Qdrant) ------------------------------------------------------
# Leave QDRANT_URL BLANK to run Qdrant embedded/local (default, no server).
# Set it to point at a hosted Qdrant instance, e.g. https://xxx.qdrant.tech
QDRANT_URL=
# QDRANT_API_KEY=
# Path used for the embedded on-disk Qdrant store (ignored when QDRANT_URL set)
QDRANT_PATH=./data/qdrant

# --- Retrieval / chunking knobs (all optional) -------------------------------
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=4

# --- Agent retry caps (guarantee termination) --------------------------------
# MAX_REGENERATIONS=2
# MAX_WEB_ESCALATIONS=1

# --- CORS: comma-separated list of allowed frontend origins ------------------
# e.g. https://your-app.vercel.app,http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000
